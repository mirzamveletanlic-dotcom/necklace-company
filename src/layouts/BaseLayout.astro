---
import "../styles/app.css";

interface Props {
  title?: string;
}

const { title = "Halden" } = Astro.props;
---

<!doctype html>
<html lang="en-CA" data-theme="strand">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/scroll-effects.ts";
    </script>
  </body>
</html>
