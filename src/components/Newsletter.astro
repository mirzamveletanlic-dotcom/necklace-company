<section id="newsletter" class="newsletter-band" aria-labelledby="newsletter-heading">
  <div class="container-halden">
    <div class="newsletter-card scroll-reveal">
      <h2 id="newsletter-heading" class="newsletter-card__title">
        Subscribe for studio updates, new pieces &amp; visit hours.
      </h2>
      <form class="newsletter-card__form" action="#" method="post">
        <label for="email" class="visually-hidden">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="name@email.com"
          class="newsletter-card__input"
        />
        <input type="submit" value="Subscribe" class="newsletter-card__submit" />
      </form>
    </div>
  </div>
</section>
