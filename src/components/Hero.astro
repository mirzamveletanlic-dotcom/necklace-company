---
import HaldenImage from "./HaldenImage.astro";
---

<section class="hero-fullbleed" aria-labelledby="hero-heading">
  <div class="hero-fullbleed__media">
    <HaldenImage
      base="/images/hero"
      alt="A gold-fill necklace worn at the collarbone in natural light."
      width={2400}
      height={1400}
      loading="eager"
      fetchpriority="high"
      cover
      objectPosition="50% 35%"
      comment="Hero: necklace worn at the collarbone in natural light"
    />
  </div>
  <div class="hero-fullbleed__overlay" aria-hidden="true"></div>
  <div class="hero-fullbleed__content container-halden">
    <p class="text-eyebrow scroll-reveal">Made in Toronto, one at a time</p>
    <div class="mt-16 flex flex-col gap-16">
      <h1 id="hero-heading" class="text-headline scroll-reveal">
        Necklaces you'll wear until they're yours.
      </h1>
      <p class="text-subhead hero-fullbleed__subhead scroll-reveal">
        Small-batch chains and pendants, hand-forged in a Leslieville studio
        from recycled gold-fill and sterling. Made to order, made to last.
      </p>
    </div>
    <div
      class="mt-48 flex w-full flex-col gap-16 md:mt-64 md:w-auto md:flex-row"
    >
      <a href="#collection" class="btn btn-primary btn-link scroll-reveal w-full md:w-auto">
        Shop the collection
      </a>
      <a href="#process" class="btn btn-secondary btn-link scroll-reveal w-full md:w-auto">
        How they're made
      </a>
    </div>
  </div>
</section>
