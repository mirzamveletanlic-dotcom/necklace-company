<header class="site-header" data-header>
  <div class="site-header__shell">
    <div class="site-header__bar">
      <a href="/" class="wordmark site-header__brand text-link-plain no-underline">
        Halden
      </a>

      <div class="site-header__actions">
        <button
          type="button"
          class="site-header__icon-btn"
          aria-label="Shopping cart"
        >
          <svg
            class="site-header__icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path d="M6 6h15l-1.5 9h-12z"></path>
            <path d="M6 6 5 3H2"></path>
            <circle cx="9" cy="20" r="1"></circle>
            <circle cx="18" cy="20" r="1"></circle>
          </svg>
          <span class="site-header__badge">0</span>
        </button>

        <button
          type="button"
          class="site-header__icon-btn"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="header-dropdown"
          aria-label="Open menu"
        >
          <svg
            class="site-header__icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 8h16M4 16h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      class="site-header__dropdown"
      id="header-dropdown"
      data-mobile-nav
      hidden
    >
      <nav class="site-header__dropdown-nav" aria-label="Main">
        <ul class="site-header__dropdown-links">
          <li>
            <a href="#collection" class="site-header__dropdown-link" data-nav-close
              >Collection</a
            >
          </li>
          <li>
            <a href="#solutions" class="site-header__dropdown-link" data-nav-close
              >Materials</a
            >
          </li>
          <li>
            <a href="#reviews" class="site-header__dropdown-link" data-nav-close
              >Reviews</a
            >
          </li>
          <li>
            <a href="#faq" class="site-header__dropdown-link" data-nav-close>FAQs</a>
          </li>
          <li>
            <a href="#newsletter" class="site-header__dropdown-link" data-nav-close
              >Newsletter</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
