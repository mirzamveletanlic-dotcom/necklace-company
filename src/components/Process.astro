---
import BadgePill from "./BadgePill.astro";

const steps = [
  {
    number: "01",
    name: "Draw",
    line: "Every piece starts as a pencil drawing at actual size.",
  },
  {
    number: "02",
    name: "Cut and forge",
    line: "Wire is cut, annealed, and hammered flat by hand.",
  },
  {
    number: "03",
    name: "Solder and set",
    line: "Links are closed individually. Stones are set last.",
  },
  {
    number: "04",
    name: "Tumble and finish",
    line: "Twelve hours in steel shot, then hand-polished.",
  },
];
---

<section id="process" class="bg-base-100" aria-labelledby="process-heading">
  <div class="container-halden section-seam section-y">
    <div class="process-layout">
      <div class="process-layout__header scroll-reveal">
        <div class="section-header">
          <BadgePill label="At the bench" />
          <h2 id="process-heading" class="text-headline-sm">
            Four steps, about nine hours.
          </h2>
          <p class="text-subhead text-subhead--muted">
            Nothing here is cast, stamped, or assembled from parts. The four steps
            below are the whole process, start to finish.
          </p>
        </div>
      </div>
      <div class="process-layout__steps" data-reveal-group>
        {
          steps.map((step) => (
            <article class="scroll-reveal feature-card">
              <span class="feature-card__badge">{step.number}</span>
              <h3 class="feature-card__title">{step.name}</h3>
              <p class="feature-card__line">{step.line}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
