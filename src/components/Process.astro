---
const steps = [
  {
    number: "01",
    name: "Draw",
    line: "Every piece starts as a pencil drawing at actual size.",
  },
  {
    number: "02",
    name: "Cut and forge",
    line: "Wire is cut, annealed, and hammered flat by hand.",
  },
  {
    number: "03",
    name: "Solder and set",
    line: "Links are closed individually. Stones are set last.",
  },
  {
    number: "04",
    name: "Tumble and finish",
    line: "Twelve hours in steel shot, then hand-polished.",
  },
];
---

<section id="process" class="section-y bg-base-100" aria-labelledby="process-heading">
  <div class="container-halden">
    <div class="section-header">
      <p class="text-eyebrow">At the bench</p>
      <h2 id="process-heading" class="text-headline">
        Four steps, about nine hours.
      </h2>
      <p class="text-subhead">
        Nothing here is cast, stamped, or assembled from parts. The four steps
        below are the whole process, start to finish.
      </p>
    </div>
    <div class="section-content grid grid-cols-1 gap-32 md:grid-cols-4">
      {
        steps.map((step) => (
          <div class="flex flex-col gap-16">
            <p class="text-display-20 text-primary">{step.number}</p>
            <h3 class="text-display-20">{step.name}</h3>
            <p class="text-body max-w-none">{step.line}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
