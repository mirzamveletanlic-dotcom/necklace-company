---
import HaldenImage from "./HaldenImage.astro";

const products = [
  {
    slug: "bight",
    name: "Bight",
    description: "A single loop of wire, forged flat where it crosses.",
    price: "$132",
    alt: "A thin gold-fill necklace with a single forged loop pendant, photographed flat.",
    comment: "Bight: on plain warm paper, directly from above",
  },
  {
    slug: "lakeshore",
    name: "Lakeshore",
    description: "The thinnest chain we make that still takes daily wear.",
    price: "$148",
    alt: "A delicate gold-fill chain necklace, the thinnest in the Halden line, photographed flat.",
    comment: "Lakeshore: on plain warm paper, directly from above",
  },
  {
    slug: "keel",
    name: "Keel",
    description: "A forged bar, oxidised dark and left slightly uneven.",
    price: "$186",
    alt: "A forged bar pendant in oxidised sterling, left slightly uneven, photographed flat.",
    comment: "Keel: on plain warm paper, directly from above",
  },
  {
    slug: "tender",
    name: "Tender",
    description: "One pearl, drilled and set by hand, off-centre on purpose.",
    price: "$224",
    alt: "One freshwater pearl set off-centre on a gold-fill chain, photographed flat.",
    comment: "Tender: on plain warm paper, directly from above",
  },
  {
    slug: "leeward",
    name: "Leeward",
    description: "Two chains at different lengths, one warm and one dark.",
    price: "$268",
    alt: "Two necklaces at different lengths, one warm gold-fill and one dark oxidised sterling, photographed flat.",
    comment: "Leeward: on plain warm paper, directly from above",
  },
  {
    slug: "ballast",
    name: "Ballast",
    description: "Heavy oval links, soldered closed one at a time.",
    price: "$310",
    alt: "Heavy oval links in gold-fill, soldered closed one at a time, photographed flat.",
    comment: "Ballast: on plain warm paper, directly from above",
  },
];
---

<section id="collection" class="bg-base-100" aria-labelledby="collection-heading">
  <div class="container-halden section-seam section-y">
    <div class="section-header">
      <p class="text-eyebrow">The collection</p>
      <h2 id="collection-heading" class="text-headline-sm">
        Six pieces. That's the whole line.
      </h2>
      <p class="text-subhead">
        Each one is made after you order it, which is why there are six and not
        sixty.
      </p>
    </div>
    <div
      class="section-content grid grid-cols-1 gap-x-48 gap-y-96 md:grid-cols-3"
    >
      {
        products.map((product) => (
          <article class="flex flex-col gap-16">
            <HaldenImage
              base={`/images/${product.slug}`}
              alt={product.alt}
              width={800}
              height={1000}
              comment={product.comment}
            />
            <div class="product-title-row">
              <span class="product-title-row__name">{product.name}</span>
              <span class="product-title-row__hairline" aria-hidden="true" />
              <span class="product-title-row__price">{product.price}</span>
            </div>
            <p class="text-product-description max-w-none">{product.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
