---
const items = [
  {
    title: "Resizing",
    line: "Free within 60 days, any length, no questions.",
  },
  {
    title: "Repairs",
    line: "Lifetime, on anything we made. You pay shipping one way.",
  },
  {
    title: "Care",
    line: "Store flat and dry. Take it off before the pool, not the shower.",
  },
];
---

<section id="care" class="bg-base-100" aria-labelledby="care-heading">
  <div class="container-halden section-seam section-y">
    <div class="section-header scroll-reveal">
      <p class="text-eyebrow">After you buy</p>
      <h2 id="care-heading" class="text-headline-sm">
        Free resizing, lifetime repairs.
      </h2>
    </div>
    <div class="section-content grid grid-cols-1 gap-32 md:grid-cols-3" data-reveal-group>
      {
        items.map((item) => (
          <article class="scroll-reveal card flex flex-col gap-16">
            <h3 class="process-step-name">{item.title}</h3>
            <p class="text-body max-w-none">{item.line}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
