---
import HaldenImage from "./HaldenImage.astro";
---

<section class="display-moment" aria-label="Halden">
  <div class="display-moment__media">
    <HaldenImage
      base="/images/display"
      alt="Bench tools, wire, and hands mid-work at a jewellery workbench."
      width={2400}
      height={1350}
      cover
      comment="Display moment: bench photograph full-bleed"
    />
  </div>
  <p class="text-display display-moment__title" aria-hidden="true">Halden</p>
</section>
