<section id="newsletter" class="section-y bg-base-200" aria-labelledby="newsletter-heading">
  <div class="container-halden">
    <div class="section-header">
      <h2 id="newsletter-heading" class="text-headline">Two emails a year.</h2>
      <p class="text-subhead">
        New pieces and studio hours. Nothing else.
      </p>
    </div>
    <div class="section-content">
      <form
        class="flex max-w-prose flex-col gap-16 md:flex-row md:items-stretch"
        action="#"
        method="post"
      >
        <div class="flex flex-1 flex-col">
          <label for="email" class="visually-hidden">EMAIL</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="w-full border border-base-content bg-base-200 px-16 py-16 text-base-content"
            style="border-radius: var(--radius-field)"
          />
        </div>
        <input
          type="submit"
          value="Sign up"
          class="newsletter-submit text-label w-full cursor-pointer border border-base-content bg-transparent px-32 py-16 md:w-auto"
          style="border-radius: var(--radius-field)"
        />
      </form>
    </div>

    <div
      class="mt-64 border-t border-base-300 pt-64"
      aria-label="Footer"
    >
      <div class="grid grid-cols-1 gap-32 md:grid-cols-3">
        <div class="flex flex-col gap-16">
          <p class="text-label">Shop</p>
          <ul class="flex flex-col gap-16">
            <li><a href="#collection" class="text-link-plain">Collection</a></li>
            <li><a href="#materials" class="text-link-plain">Materials</a></li>
            <li><a href="#care" class="text-link-plain">Care</a></li>
            <li>
              <a href="#newsletter" class="text-link-plain">Shipping and returns</a>
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-16">
          <p class="text-label">Studio</p>
          <ul class="flex flex-col gap-16">
            <li><a href="#studio" class="text-link-plain">About</a></li>
            <li>
              <a href="#studio" class="text-link-plain">Visit by appointment</a>
            </li>
            <li><a href="#care" class="text-link-plain">Repairs</a></li>
          </ul>
        </div>
        <div class="flex flex-col gap-16">
          <p class="text-label">Contact</p>
          <ul class="flex flex-col gap-16">
            <li>
              <a href="mailto:hello@halden.co" class="text-link-plain"
                >hello@halden.co</a
              >
            </li>
            <li>Leslieville, Toronto ON</li>
            <li>Thursdays by appointment</li>
          </ul>
        </div>
      </div>
      <p class="text-body mt-48 max-w-none md:mt-64">Halden. Made in Toronto.</p>
    </div>
  </div>
</section>
