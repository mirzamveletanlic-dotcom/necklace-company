---
const items = [
  {
    question: "Are Halden pieces suitable for sensitive skin?",
    answer:
      "Yes. We use bonded gold-fill and oxidised sterling with no nickel and no plating. If you react to a specific metal, email us before ordering and we can recommend the right piece.",
  },
  {
    question: "Are your products cruelty-free and vegan?",
    answer:
      "Our jewellery is made from metal only — no animal products in the pieces themselves. Studio materials are sourced from suppliers who do not test on animals.",
  },
  {
    question: "How soon will I receive my order?",
    answer:
      "Seven to ten business days from order. Everything is made after you order it, which is why there are six pieces and not sixty.",
  },
  {
    question: "Can I wear Halden necklaces during pregnancy?",
    answer:
      "Many customers wear our gold-fill and sterling pieces throughout pregnancy. If you have metal sensitivities, we recommend Lakeshore or Bight — our thinnest gold-fill chains with no nickel.",
  },
  {
    question: "Do you ship internationally?",
    answer:
      "We ship to Canada and the United States. Free shipping in Canada on orders over $150.",
  },
  {
    question: "Where are Halden pieces made?",
    answer:
      "Every necklace is hand-forged in our Leslieville studio in Toronto. The bench is open by appointment on Thursdays.",
  },
];
---

<section id="faq" class="bg-base-100 surface-grid" aria-labelledby="faq-heading">
  <div class="container-halden section-seam section-y">
    <div class="section-header section-header--center scroll-reveal">
      <h2 id="faq-heading" class="text-headline-sm">FAQs</h2>
      <p class="text-subhead text-subhead--muted section-header__subhead">
        We believe in clarity and transparency. Here are answers to the most
        common questions about our necklaces.
      </p>
    </div>
    <div class="section-content faq-layout">
      <div class="faq-list">
        {
          items.map((item) => (
            <details class="faq-item">
              <summary class="text-faq-question">{item.question}</summary>
              <p class="faq-answer text-body max-w-none">{item.answer}</p>
            </details>
          ))
        }
      </div>
      <aside class="faq-cta scroll-reveal">
        <h3 class="faq-cta__title">You have different questions?</h3>
        <p class="faq-cta__line">
          Our team will answer all your questions. We ensure a quick response.
        </p>
        <a href="mailto:hello@halden.co" class="btn btn-primary btn--arrow btn-link">
          <span>Contact Us</span>
          <span class="btn__icon" aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </div>
</section>
