---
interface Props {
  base: string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "auto";
  comment?: string;
  cover?: boolean;
  objectPosition?: string;
}

const {
  base,
  alt,
  width,
  height,
  loading = "lazy",
  fetchpriority,
  comment,
  cover = false,
  objectPosition,
} = Astro.props;

const classes = ["halden-image", cover ? "halden-image--cover" : ""]
  .filter(Boolean)
  .join(" ");
---

{comment && <Fragment set:html={`<!-- ${comment} -->`} />}
<picture>
  <source srcset={`${base}.webp`} type="image/webp" />
  <img
    src={`${base}.jpg`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={classes}
    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
  />
</picture>
