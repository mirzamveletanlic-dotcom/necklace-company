---
const items = [
  {
    title: "Global Shipping",
    line: "Reliable delivery across Canada and the United States on every order.",
  },
  {
    title: "Studio Guidance",
    line: "Expert advice on length, layering, and care whenever you need it.",
  },
  {
    title: "Secure Checkout",
    line: "Safe and protected payment process for every order placed.",
  },
  {
    title: "Lifetime Repairs",
    line: "Lifetime repairs on anything we made. You pay shipping one way.",
  },
];
---

<section class="benefits-band" aria-label="Purchase benefits">
  <div class="container-halden">
    <div class="benefits-grid scroll-reveal" data-reveal-group>
      {
        items.map((item) => (
          <article class="benefit-card scroll-reveal">
            <h3 class="benefit-card__title">{item.title}</h3>
            <p class="benefit-card__line">{item.line}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
