---
interface Props {
  ratio: "4/5" | "3/2";
  alt: string;
  comment: string;
}

const { ratio, alt, comment } = Astro.props;
const aspectClass = ratio === "4/5" ? "aspect-[4/5]" : "aspect-[3/2]";
---

<Fragment set:html={`<!-- ${comment} -->`} />
<div
  class={`image-slot ${aspectClass} w-full`}
  role="img"
  aria-label={alt}
>
</div>
