---
import HaldenImage from "./HaldenImage.astro";
---

<section
  id="studio"
  class="bleed-section bg-neutral text-neutral-content"
  aria-labelledby="studio-heading"
>
  <div class="container-halden bleed-section__grid">
    <div class="bleed-section__copy scroll-reveal">
      <div class="section-header">
        <p class="text-eyebrow">The studio</p>
        <h2 id="studio-heading" class="text-headline-sm">
          One person, one bench, since 2019.
        </h2>
        <div class="flex flex-col gap-16">
          <p class="text-body max-w-none">
            Nora Halden trained as a silversmith in Halifax and moved the bench
            to Leslieville in 2019. She makes every piece herself. When you
            order, she is the one who cuts the wire.
          </p>
          <p class="text-body max-w-none">
            The studio is open by appointment on Thursdays if you want to try
            something on before you buy it.
          </p>
        </div>
      </div>
    </div>
    <div class="bleed-section__media bleed-section__media--right bleed-right scroll-reveal">
      <HaldenImage
        base="/images/studio"
        alt="Bench tools, wire, and hands mid-work at a jewellery workbench."
        width={1500}
        height={1000}
        comment="Studio: bench tools, wire, hands mid-work"
      />
    </div>
  </div>
</section>
