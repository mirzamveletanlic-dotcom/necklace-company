---
import ImageSlot from "./ImageSlot.astro";
---

<section
  id="studio"
  class="section-y bg-neutral text-neutral-content"
  aria-labelledby="studio-heading"
>
  <div class="container-halden">
    <div class="grid grid-cols-1 gap-32 md:grid-cols-2 md:items-start">
      <div class="section-header">
        <p class="text-eyebrow">The studio</p>
        <h2 id="studio-heading" class="text-headline">
          One person, one bench, since 2019.
        </h2>
        <div class="flex flex-col gap-16">
          <p class="text-body max-w-none">
            Nora Halden trained as a silversmith in Halifax and moved the bench
            to Leslieville in 2019. She makes every piece herself. When you
            order, she is the one who cuts the wire.
          </p>
          <p class="text-body max-w-none">
            The studio is open by appointment on Thursdays if you want to try
            something on before you buy it.
          </p>
        </div>
      </div>
      <ImageSlot
        ratio="3/2"
        alt="Bench tools, wire, and hands mid-work in the Leslieville studio"
        comment="Studio: bench tools, wire, hands mid-work"
      />
    </div>
  </div>
</section>
